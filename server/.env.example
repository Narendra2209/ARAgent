# ============================================================
#  MYOB AR Aging Dashboard — environment configuration
#  Copy this file to ".env" and fill in your values.
# ============================================================

# ---- Server ----
PORT=4000

# ---- Demo mode ----
# true  = serve built-in sample data, no MYOB calls (preview the dashboard)
# false = call MYOB Acumatica using the settings below
USE_MOCK_DATA=true

# ============================================================
#  MYOB Acumatica / Advanced
# ============================================================
# Base URL of your instance (NO trailing slash)
# e.g. https://yourcompany.myob.acumatica.com  or  https://yourcompany.myobadvanced.com
MYOB_BASE_URL=

# Contract-based REST endpoint name + version (check yours under
#  System > Integration > Web Service Endpoints; MYOB default is usually "Default")
MYOB_ENDPOINT_NAME=Default
MYOB_ENDPOINT_VERSION=23.200.001

# ---- Auth: cookie-based login (most common for MYOB Acumatica REST) ----
MYOB_USERNAME=
MYOB_PASSWORD=
# Tenant/company login name (the value you pick in the company dropdown at sign-in).
# Leave blank if your instance has a single company.
MYOB_COMPANY=
# Optional branch
MYOB_BRANCH=

# ============================================================
#  AR Aging data source strategy
# ============================================================
# computed = pull open AR documents via the contract REST API and compute the
#            aging buckets in this app (no Generic Inquiry needed). DEFAULT.
# odata    = read a Generic Inquiry exposed via OData (set MYOB_GI_NAME).
AR_AGING_STRATEGY=computed

# Generic Inquiry name (only used when AR_AGING_STRATEGY=odata)
MYOB_GI_NAME=

# As-of date for aging calculation in YYYY-MM-DD (blank = today)
AR_AS_OF_DATE=

# ============================================================
#  Email — overdue reminders sent "from Outlook" via Microsoft Graph
# ============================================================
# One-time Azure setup: register an app in Entra ID (Azure AD), add a client
# secret, grant the Application permission "Mail.Send" (Microsoft Graph) with
# admin consent, then fill in the values below.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# The mailbox reminders are sent FROM (a licensed Microsoft 365 user/shared mailbox)
GRAPH_SENDER=

# ---- Reminder behaviour ----
# true  = TEST mode: every reminder goes to MAIL_TEST_RECIPIENT (safe for testing)
# false = send to each customer's own email address
MAIL_TEST_MODE=true
MAIL_TEST_RECIPIENT=narendrareddy2209@gmail.com
# Fallback used for customers with no email on file in MYOB
CUSTOMER_DEFAULT_EMAIL=narendrareddy2209@gmail.com
# Shown in the email body / subject
MAIL_COMPANY_NAME=Metfold
MAIL_FROM_NAME=Accounts Receivable

# ============================================================
#  Database (required for login — users are stored here)
# ============================================================
MONGODB_URI=
MONGODB_DB_NAME=ar_agent

# ============================================================
#  Authentication (login / admin & user roles)
# ============================================================
# Secret used to sign login tokens — set to a long random string.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# How long a login stays valid (e.g. 12h, 7d)
JWT_TTL=12h
